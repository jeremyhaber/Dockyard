FROM ubuntu:24.04
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server openssh-client openssh-sftp-server sudo passwd \
 && rm -rf /var/lib/apt/lists/* \
 && userdel -r ubuntu \
 && mkdir -p /run/sshd /etc/ssh/authorized_keys \
 && useradd -m -u 1000 -s /bin/bash dockyard \
 && echo 'dockyard:dockyard-test-pw' | chpasswd \
 && echo 'root:root-test-pw' | chpasswd \
 && echo 'dockyard ALL=(ALL) ALL' > /etc/sudoers.d/dockyard \
 && chmod 440 /etc/sudoers.d/dockyard \
 && ssh-keygen -A
COPY --chmod=755 sshd-entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
